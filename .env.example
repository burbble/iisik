LAB7_DATA_DIR=.data
LAB7_EVENT_BACKEND=kafka
LAB7_SESSION_BACKEND=redis
LAB7_CACHE_BACKEND=redis
REDIS_URL=redis://127.0.0.1:6379/0
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC=profitability.events
KAFKA_DEAD_LETTER_TOPIC=profitability.events.dlq
KAFKA_MAX_ATTEMPTS=3
KAFKA_RETRY_BACKOFF_SECONDS=0.10
GRPC_TIMEOUT_SECONDS=2.0
GRPC_MAX_ATTEMPTS=3
GRPC_RETRY_BACKOFF_SECONDS=0.05
COSTING_CONTEXT_CACHE_TTL_SECONDS=300
LOG_LEVEL=INFO
JWT_SECRET=lab7-development-secret-change-me
JWT_TTL_SECONDS=3600

# Separate service authentication secret (at least 32 random characters)
INTERNAL_JWT_SECRET=replace-with-a-random-service-secret-before-running
