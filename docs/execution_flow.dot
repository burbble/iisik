digraph Flow {
 graph [rankdir=TB,bgcolor="white",pad=0.3];
 node [shape=box,fontname="DejaVu Sans",fontsize=11,style="rounded,filled",fillcolor="#f5f5f5"];
 edge [fontname="DejaVu Sans",fontsize=9];
 a [label="Gateway: user JWT, active session, role"];
 b [label="Costing: typed gRPC, service JWT\nMaster Data + plan, Production + Financial"];
 c [label="One transaction\nCostCalculation + OverheadAllocation + OutboxEvent"];
 d [label="Dispatcher -> Kafka\nretry pending events after recovery"];
 e [label="Analytics\nrequested cost version + sales\nsame correlationId"];
 f [label="ProfitabilityCalculated -> Reporting read model"];
 g [label="GraphQL profitability / summary\nCSV, XLSX, PDF export"];
 a -> b -> c -> d -> e -> f -> g;
}