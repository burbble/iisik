digraph G {
  graph [rankdir=LR, bgcolor="white", fontname="Arial", nodesep=0.35, ranksep=0.45];
  node [shape=box, style="rounded", color="black", fontcolor="black", fontname="Arial"];
  edge [color="black", fontcolor="black", fontname="Arial", fontsize=9];

  client [label="Client"];
  gateway [label="GraphQL Gateway"];
  costing [label="Costing Service"];
  master [label="Master Data"];
  production [label="Production"];
  financial [label="Financial"];
  kafka1 [label="Kafka\nCostCalculationCompleted", shape=component];
  analytics [label="Profitability Analytics"];
  kafka2 [label="Kafka\nProfitabilityCalculated", shape=component];
  reporting [label="Reporting"];

  client -> gateway [label="GraphQL"];
  gateway -> costing [label="gRPC CalculateCost"];
  costing -> master [label="gRPC context"];
  costing -> production [label="gRPC costs"];
  costing -> financial [label="gRPC overhead"];
  costing -> kafka1 [label="publish"];
  kafka1 -> analytics [label="consume"];
  analytics -> costing [label="gRPC approved cost"];
  analytics -> financial [label="gRPC sales"];
  analytics -> kafka2 [label="publish"];
  kafka2 -> reporting [label="consume"];
}
