digraph Architecture {
 graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.4, ranksep=0.55];
 node [shape=box, style="rounded,filled", fillcolor="#f5f5f5", fontname="DejaVu Sans", fontsize=10];
 edge [fontname="DejaVu Sans", fontsize=8];
 client [label="Клиент"]; gateway [label="GraphQL Gateway\nUser JWT + sessions + RBAC"];
 auth [label="Auth / Identity\nidentity.db"]; redis [label="Redis\nsessions + costing cache"];
 master [label="Master Data\nmaster_data.db\nplans + mappings"];
 production [label="Production Integration\nproduction.db + outbox"];
 financial [label="Financial Integration\nfinancial.db + outbox\nOVERHEAD / CORRECTION"];
 costing [label="Costing\ncosting.db + outbox\ncalculations + allocation details"];
 analytics [label="Analytics\nanalytics.db\nexact cost version"];
 reporting [label="Reporting\nreporting.db\nread model + exports"];
 kafka [label="Kafka\nprofitability.events + DLQ",shape=component];
 client -> gateway; gateway -> auth; auth -> redis;
 gateway -> master [label="service JWT / gRPC"]; gateway -> production; gateway -> financial;
 gateway -> costing; gateway -> analytics; gateway -> reporting [label="profitability / summary / export"];
 costing -> master; costing -> production; costing -> financial; costing -> redis [style=dashed,label="TTL / invalidate"];
 production -> kafka [label="actual import outcome"]; financial -> kafka [label="actual import outcome"];
 master -> kafka [label="MasterDataChanged"]; costing -> kafka [label="outbox dispatcher"];
 kafka -> costing [label="readiness + INVALIDATED"]; kafka -> analytics [label="CostCalculationCompleted"];
 analytics -> kafka [label="ProfitabilityCalculated\nsame correlationId"]; kafka -> reporting [label="projection + invalidation"];
}