digraph G {
  graph [rankdir=TB, bgcolor="white", fontname="Arial", nodesep=0.35, ranksep=0.55];
  node [shape=box, style="rounded", color="black", fontcolor="black", fontname="Arial"];
  edge [color="black", fontcolor="black", fontname="Arial", fontsize=9];

  client [label="Web client"];
  gateway [label="GraphQL Gateway\n:8000"];
  auth [label="Auth Service\nREST :8001"];
  redis [label="Redis sessions", shape=cylinder];

  master [label="Master Data\ngRPC :50051"];
  production [label="Production Integration\ngRPC :50052"];
  financial [label="Financial Integration\ngRPC :50053"];
  costing [label="Costing\ngRPC :50054"];
  analytics [label="Profitability Analytics\ngRPC :50055"];
  reporting [label="Reporting\ngRPC :50056"];
  kafka [label="Kafka\nprofitability.events", shape=component];

  masterdb [label="master_data.db", shape=cylinder];
  productiondb [label="production.db", shape=cylinder];
  financedb [label="finance.db", shape=cylinder];
  costingdb [label="costing.db", shape=cylinder];
  analyticsdb [label="analytics.db", shape=cylinder];
  reportingdb [label="reporting.db", shape=cylinder];
  identitydb [label="identity.db", shape=cylinder];

  client -> gateway [label="GraphQL + JWT"];
  gateway -> auth [label="REST verify/login"];
  auth -> redis [label="session TTL"];
  auth -> identitydb;

  gateway -> master [label="gRPC"];
  gateway -> production [label="gRPC"];
  gateway -> financial [label="gRPC"];
  gateway -> costing [label="gRPC"];
  gateway -> analytics [label="gRPC"];
  gateway -> reporting [label="gRPC"];

  costing -> master [label="GetCostingContext"];
  costing -> production [label="GetProductionCostData"];
  costing -> financial [label="GetOverheadData"];
  analytics -> costing [label="GetApprovedCostCalculation"];
  analytics -> financial [label="GetSalesData"];

  master -> masterdb;
  production -> productiondb;
  financial -> financedb;
  costing -> costingdb;
  analytics -> analyticsdb;
  reporting -> reportingdb;

  master -> kafka [label="MasterDataChanged"];
  production -> kafka [label="ProductionDataImported"];
  financial -> kafka [label="FinancialDataImported"];
  costing -> kafka [label="CostCalculationCompleted"];
  analytics -> kafka [label="ProfitabilityCalculated"];

  kafka -> costing [label="ready events"];
  kafka -> analytics [label="cost completed"];
  kafka -> reporting [label="profitability calculated"];
}
